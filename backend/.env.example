# FayeLong 后端配置模板
#
# 用法：复制本文件为 backend/.env，按需取消注释并修改。
# 所有变量都可省略 —— 省略时使用 app/core/config.py 中的默认值。
# 列表类型使用 JSON 数组写法，例如 ["youdao","mymemory"]

# ---------------- 服务 ----------------
# FAYELONG_APP_NAME=FayeLong 英语学习网站
# FAYELONG_HOST=127.0.0.1
# FAYELONG_PORT=8000

# ---------------- 语音识别（faster-whisper）----------------
# FAYELONG_WHISPER_MODEL=small          # tiny / base / small / medium / large-v3
# FAYELONG_WHISPER_LANGUAGE=en
# FAYELONG_WHISPER_DEVICE=cpu           # cpu / cuda
# FAYELONG_WHISPER_COMPUTE_TYPE=int8    # int8 / float16 / int8_float16
# FAYELONG_WHISPER_BEAM_SIZE=5
# FAYELONG_WHISPER_VAD=true             # Silero VAD 过滤静音，减少幻听
# FAYELONG_WHISPER_WORD_TIMESTAMPS=true # 词级时间戳，句子切分更稳
# FAYELONG_WHISPER_REPO=Systran/faster-whisper-{model}
# FAYELONG_HF_ENDPOINT=https://hf-mirror.com   # 留空则用官方 huggingface.co

# ---------------- 句子切分 ----------------
# FAYELONG_SEGMENT_MIN_MS=700           # 短于此的句子与下一句合并
# FAYELONG_SEGMENT_MAX_MS=15000         # 超过此长度强制切分
# FAYELONG_SEGMENT_MAX_CHARS=180        # 超过此字符数强制切分

# ---------------- 音频切片 ----------------
# FAYELONG_CLIP_PADDING_MS=120          # 切片前后留白，避免截断首尾音
# FAYELONG_CLIP_BITRATE=64k             # mp3 码率（语音足够）
# FAYELONG_CLIP_FORMAT=mp3

# ---------------- 音频转码 ----------------
# FAYELONG_TRANSCODE_SAMPLE_RATE=16000  # ASR 友好
# FAYELONG_TRANSCODE_CHANNELS=1
# FAYELONG_FFMPEG_THREADS=0             # 0 = 让 ffmpeg 自行决定

# ---------------- 听写校验 ----------------
# FAYELONG_DICTATION_IGNORE_CASE=true
# FAYELONG_DICTATION_IGNORE_PUNCTUATION=true
# FAYELONG_DICTATION_PASS_ACCURACY=100.0    # 达到该正确率视为「已掌握」

# ---------------- 词典 ----------------
# FAYELONG_DICT_ONLINE_FALLBACK=true    # 词库未收录时用在线引擎给个参考释义

# ---------------- 翻译（免费在线免密钥引擎链，按顺序回退）----------------
# FAYELONG_TRANSLATE_ENGINES=["youdao","mymemory"]
# FAYELONG_TRANSLATE_TARGET=zh
# FAYELONG_TRANSLATE_TIMEOUT=12.0
# FAYELONG_TRANSLATE_DELAY_MS=150       # 逐句请求间隔，避免触发限流
# FAYELONG_MYMEMORY_EMAIL=              # 可选：填邮箱可提升 MyMemory 配额

# ---------------- 其他 ----------------
# FAYELONG_WORKER_THREADS=2             # 后台转码并发数，避免吃满 CPU
# FAYELONG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
